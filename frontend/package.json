{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.1.2",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite",
    "build": "pnpm test:security && pnpm generate:sitemap && tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write .",
    "preview": "vite preview",
    "start": "vite preview",
    "compile": "tsc --noEmit",
    "generate:sitemap": "node ./scripts/generate-sitemap.mjs",
    "test:security": "node ./scripts/check-admin-security.mjs"
  },
  "dependencies": {
    "@chakra-ui/icons": "^2.1.1",
    "@chakra-ui/react": "^2.8.2",
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@tabler/icons-react": "^3.5.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "framer-motion": "^11.2.6",
    "jwt-decode": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.51.5",
    "react-lazy-load-image-component": "^1.6.0",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^7.18.2",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/react-lazy-load-image-component": "^1.5.3",
    "@types/react-syntax-highlighter": "^15.5.11",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react-swc": "3.11.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "node-fetch": "^3.3.2",
    "prettier": "3.2.5",
    "typescript": "^5.2.2",
    "vite": "6.4.3"
  },
  "pnpm": {
    "overrides": {
      "ajv@>=6 <7": "6.15.0",
      "brace-expansion@<2": "1.1.18",
      "brace-expansion@>=2 <3": "2.1.4",
      "flatted@>=3 <4": "3.4.4",
      "js-yaml@>=4 <5": "4.3.2",
      "mdast-util-to-hast": "13.2.1",
      "minimatch@>=3 <4": "3.1.5",
      "minimatch@>=9 <10": "9.0.9",
      "nanoid@>=3 <4": "3.3.18",
      "picomatch@>=2 <3": "2.3.2",
      "postcss@>=8 <9": "8.5.26",
      "rollup@>=4 <5": "4.63.0",
      "yaml": "1.10.3"
    }
  }
}
